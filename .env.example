# Copy to .env and fill in. Never commit .env.

# --- security ---
# Comma-separated API keys. Every API call must send header  X-API-Key: <key>
# (the quote page asks for it once and remembers it). Empty = no auth (local dev only).
QS_API_KEYS=change-me-long-random-key
# Key for /admin/reload (send as X-Admin-Key). Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
QS_ADMIN_KEY=change-me-admin-key
# Browser origins allowed to call the API from another site (blank = same origin only)
QS_CORS_ORIGINS=

# --- service ---
QS_WORKERS=2
QS_LOG_JSON=1
QS_LOG_LEVEL=INFO

# --- data build safety ---
# refuse builds smaller than this / that lose more than this share of segments vs the previous build
QS_MIN_SEGMENTS=1000
QS_MIN_PART_LINES=1000
QS_MAX_DROP=0.3
