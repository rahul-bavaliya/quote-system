{
  "name": "quote-system",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": { "moby": false, "dockerDashComposeVersion": "v2" }
  },
  "postCreateCommand": "bash scripts/bootstrap.sh",
  "postStartCommand": "make deps",
  "forwardPorts": [8000],
  "portsAttributes": { "8000": { "label": "Quote API", "onAutoForward": "openBrowser" } },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance", "mechatroner.rainbow-csv"],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"]
      }
    }
  }
}
