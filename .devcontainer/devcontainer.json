{
  "name": "quote-system",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  "features": { "ghcr.io/devcontainers/features/docker-in-docker:2": {} },
  "postCreateCommand": "pip install --upgrade pip && pip install -e '.[dev]'",
  "postStartCommand": "make deps",
  "forwardPorts": [8000],
  "portsAttributes": { "8000": { "label": "Quote API", "onAutoForward": "openBrowser" } },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance", "mechatroner.rainbow-csv"],
      "settings": { "python.testing.pytestEnabled": true, "python.testing.pytestArgs": ["tests"] }
    }
  }
}
